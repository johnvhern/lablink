{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "libraries": [
    {
      "library": "preline@5.0.0",
      "destination": "wwwroot/lib/preline/",
      "files": [
        "dist/preline.js"
      ]
    },
    {
      "library": "htmx.org@2.0.11",
      "destination": "wwwroot/lib/htmx.org/",
      "files": [
        "dist/htmx.min.js"
      ]
    },
    {
      "library": "toastify-js@1.12.0",
      "destination": "wwwroot/lib/toastify-js/",
      "files": [
        "src/toastify.js"
      ]
    },
    {
      "library": "jquery@4.0.0",
      "destination": "wwwroot/lib/jquery/",
      "files": [
        "dist/jquery.min.js"
      ]
    },
    {
      "library": "datatables.net@3.1.3",
      "destination": "wwwroot/lib/datatables.net/",
      "files": [
        "js/dataTables.min.js"
      ]
    },
    {
      "library": "vanilla-calendar-pro@3.4.0",
      "destination": "wwwroot/lib/vanilla-calendar-pro/",
      "files": [
        "index.js"
      ]
    },
    {
      "library": "lodash@4.18.1",
      "destination": "wwwroot/lib/lodash/",
      "files": [
        "lodash.min.js"
      ]
    }
  ]
}